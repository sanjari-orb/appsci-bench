              "fontSize": 18,
              "color": "#0B0E14"
            }
          },
          {
            "type": "text",
            "name": "Text Placeholder 3",
            "content": "Platform engineering fields 46 on-call pages/month on this cluster — more than any other system we own.",
            "style": {
              "fontSize": 19,
              "color": "#0B0E14"
            }
          },
          {
            "type": "text",
            "name": "Text Placeholder 4",
            "content": "•  Uptime over the same period: 98.2%, below our 99.5% internal target.",
            "style": {
              "fontSize": 17,
              "color": "#0B0E14"
            }
          },
          {
            "type": "text",
            "name": "Text Placeholder 5",
            "content": "The cluster is at capacity: adding a new data source today requires manually re-partitioning existing jobs, which has already delayed two other teams' launches this year.",
